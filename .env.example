# paperclip-telegram-bridge configuration. Placeholders only — never commit real values.
# Secrets are read from files (*_FILE), there are no token variables on purpose.

# --- Required ---------------------------------------------------------------
PAPERCLIP_URL=http://paperclip.internal:3100
PAPERCLIP_TOKEN_FILE=/run/secrets/paperclip_token
PAPERCLIP_COMPANY_IDS=00000000-0000-0000-0000-000000000000
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_USER_ID=123456789
# http://, https://, socks5:// or socks5h:// (recommended: DNS resolved by the proxy)
TELEGRAM_PROXY_URL=socks5h://xray:1080

# --- Optional (defaults shown) ----------------------------------------------
# PAPERCLIP_UI_URL=
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# STATE_PATH=/state/bridge.db
# HEALTH_FILE=/state/health.json
# HEALTH_MAX_STALE=5m
# PAPERCLIP_POLL_INTERVAL=15s
# PAPERCLIP_RUNS_POLL_INTERVAL=60s
# TELEGRAM_LONG_POLL_TIMEOUT=25s
# PAPERCLIP_REQUEST_TIMEOUT=15s
# PAPERCLIP_GOVERNED_TIMEOUT=120s
# TELEGRAM_REQUEST_TIMEOUT=15s
# CONNECT_TIMEOUT=10s
# RETRY_BASE_DELAY=1s
# RETRY_MAX_DELAY=60s
# RETRY_MAX_ATTEMPTS=6
# RETRY_NOTIFY_AFTER=5
# NOTIFY_RUN_FAILURES=true
# NOTIFY_TASK_COMPLETED=false
# NOTIFY_RESOLVED_ELSEWHERE=true
# GOVERNED_APPROVALS_ENABLED=true
# GOVERNED_DESTRUCTIVE_MODE=confirm
# GOVERNED_SHOW_ARGUMENTS=false
# GOVERNED_RESULT_FOLLOW=30m
# MAX_MESSAGE_CHUNKS=3
# SHUTDOWN_GRACE=10s
# LOG_LEVEL=info
# LOG_FORMAT=json
