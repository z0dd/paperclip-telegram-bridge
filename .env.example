# paperclip-telegram-bridge v2 configuration. Placeholders only — never commit real values.
# Secrets are read from files (*_FILE), there are no token variables on purpose.

# --- Required ---------------------------------------------------------------
PAPERCLIP_URL=http://paperclip.internal:3100
# One board key. For several keys of the same Paperclip user use instead
# PAPERCLIP_TOKEN_FILES=/run/secrets/pc_a,/run/secrets/pc_b (not both).
PAPERCLIP_TOKEN_FILE=/run/secrets/paperclip_token
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# The private forum supergroup (Topics on, the bot is an admin with "Manage topics").
TELEGRAM_CHAT_ID=-1001234567890
# Telegram user ids allowed to write to the agents, comma-separated.
TELEGRAM_ALLOWED_USER_IDS=123456789
# http://, https://, socks5:// or socks5h:// (recommended: DNS resolved by the proxy)
TELEGRAM_PROXY_URL=socks5h://xray:1080

# --- Optional (defaults shown) ----------------------------------------------
# PAPERCLIP_UI_URL=
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# STATE_PATH=/state/bridge.db
# HEALTH_FILE=/state/health.json
# HEALTH_MAX_STALE=5m
# PAPERCLIP_POLL_INTERVAL=5s
# PAPERCLIP_DISCOVERY_INTERVAL=60s
# PAPERCLIP_SWEEP_INTERVAL=60s
# CONVERSATION_HOT_WINDOW=10m
# TELEGRAM_GROUP_MIN_INTERVAL=3s
# TELEGRAM_LONG_POLL_TIMEOUT=25s
# PAPERCLIP_REQUEST_TIMEOUT=15s
# TELEGRAM_REQUEST_TIMEOUT=15s
# CONNECT_TIMEOUT=10s
# RETRY_BASE_DELAY=1s
# RETRY_MAX_DELAY=60s
# RETRY_MAX_ATTEMPTS=6
# RETRY_NOTIFY_AFTER=5
# MAX_MESSAGE_CHUNKS=3
# SHUTDOWN_GRACE=10s
# LOG_LEVEL=info
# LOG_FORMAT=json
